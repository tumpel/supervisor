{
  "name": "tumpel-supervisor",
  "containerEnv": {
    "NPM_CONFIG_AUDIT": "false",
    "NPM_CONFIG_FUND": "false",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false"
  },
  "onCreateCommand": "npm ci && cargo fetch --locked",
  "updateContentCommand": "cargo build --workspace --all-targets --locked && cargo clippy --workspace --all-targets --locked -- -D warnings"
}
